.features = ((.features // {}) * load(strenv(RP_FIXTURES) + "/configs/codex-nested-delegation-consumer.toml").features) |
.agents.max_concurrent_threads_per_session = env(RP_THREAD_BUDGET) |
.shell_environment_policy.set.ZOTERO_HTTP_URL = strenv(ZOTERO_HTTP_URL) |
.shell_environment_policy.set.ZOTERO_MCP_URL = strenv(ZOTERO_MCP_URL) |
.shell_environment_policy.set.VISION_ENV_FILE = strenv(RP_VISION_FILE) |
.shell_environment_policy.set.OPENCODE_PK_DATA_DIR = strenv(RP_KB_DATA) |
.shell_environment_policy.set.OPENCODE_PK_MODEL_CACHE_DIR = strenv(RP_KB_CACHE) |
.shell_environment_policy.set.KB_SERVER_PATH = strenv(RP_KB_SERVER_PATH) |
.mcp_servers."chrome-devtools".env.CHROME_CDP_PORT = strenv(CHROME_CDP_PORT) |
.mcp_servers."chrome-devtools".env.CHROME_PROFILE_DIR = strenv(CHROME_PROFILE_DIR) |
.mcp_servers."chrome-devtools".env.SKILLREPO_DATA_HOME = strenv(RP_BROWSER_DATA) |
.mcp_servers."personal-knowledge".env.OPENCODE_PK_DATA_DIR = strenv(RP_KB_DATA) |
.mcp_servers."personal-knowledge".env.OPENCODE_PK_MODEL_CACHE_DIR = strenv(RP_KB_CACHE) |
.mcp_servers."personal-knowledge".env.KB_SERVER_PATH = (.mcp_servers."personal-knowledge".env.KB_SERVER_PATH // strenv(RP_KB_SERVER_PATH))
